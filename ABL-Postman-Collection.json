{
  "info": {
    "_postman_id": "b7c1d2e3-4f56-7890-abcd-ef1234567890",
    "name": "ABL - CRUD Lengkap (Auth, Produk, Pelanggan, Order)",
    "description": "1) Jalankan D:\\ABL\\start-all.bat dan tunggu status port service.\n2) Import koleksi ini.\n3) Buka folder '0 Auth' -> 'A4 Login admin' -> Send => token OTOMATIS tersimpan.\n4) Jalankan folder 1..5 berurutan. Setiap 'Create' menyimpan id otomatis ke variabel.\n\nService berjalan tanpa jendela CMD terpisah; log ada di run.log masing-masing modul. RabbitMQ berjalan sebagai Windows Service. Consumer/email opsional dan dapat mengirim email sungguhan; jangan aktifkan tanpa izin.\n\nbaseUrl = http://localhost:9001 (gateway; Eureka harus jalan).\nAlternatif port langsung: urlAuth=8086, urlProduk=8083, urlPelanggan=8082, urlOrder=8081.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9001", "type": "string" },
    { "key": "urlAuth", "value": "http://localhost:8086", "type": "string" },
    { "key": "urlProduk", "value": "http://localhost:8083", "type": "string" },
    { "key": "urlPelanggan", "value": "http://localhost:8082", "type": "string" },
    { "key": "urlOrder", "value": "http://localhost:8081", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "produkId", "value": "", "type": "string" },
    { "key": "jenisProdukId", "value": "", "type": "string" },
    { "key": "pelangganId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0 Auth (tanpa token)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "A1 Register user baru",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"siswa1\",\n  \"password\": \"rahasia123\",\n  \"email\": \"siswa1@example.com\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "register" ] }
          }
        },
        {
          "name": "A2 Register duplikat (ekspetasi 409)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"siswa1\",\n  \"password\": \"rahasia123\",\n  \"email\": \"siswa1@example.com\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "register" ] }
          }
        },
        {
          "name": "A3 Register kosong (ekspetasi 400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"\",\n  \"password\": \"\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "register" ] }
          }
        },
        {
          "name": "A4 Login admin (SIMPAAN TOKEN OTOMATIS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set(\"token\", r.token);",
                  "  console.log(\"TOKEN tersimpan otomatis ke variabel {{token}}\");",
                  "} else {",
                  "  console.log(\"Login gagal, status: \" + pm.response.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] }
          }
        },
        {
          "name": "A5 Login salah password (ekspetasi 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"salah\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] }
          }
        },
        {
          "name": "A6 Login username tidak ada (ekspetasi 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"hantu\",\n  \"password\": \"x\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] }
          }
        }
      ]
    },
